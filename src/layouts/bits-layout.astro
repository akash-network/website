---
import PostCard from "@/components/cards/post-card.astro";
import CTA from "@/components/CTA.astro";
import Footer from "@/components/footer/footer.astro";
import Header from "@/components/header/header.astro";
import "@/styles/globals.css";
import { getReadingTime } from "@/utils/readingTime";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseLayout from "./base-layout.astro";

type BitsPost = CollectionEntry<"Bits">;

interface Props {
  title: string;
  description?: string;
  image?: string;
  relatedPosts?: BitsPost[];
}

const { title, description, image } = Astro.props;

const slug = Astro.url.pathname.split("/")[2];

const relatedPosts = (
  await getCollection("Bits")
    .then((posts) => posts.filter((p) => !p.data.draft && p.id !== slug))
    .then((posts) =>
      posts.sort(
        (a, b) =>
          new Date(b.data.pubDate).getTime() -
          new Date(a.data.pubDate).getTime(),
      ),
    )
).slice(0, 3);
---

<BaseLayout title={title} description={description} image={image}>
  <Header />

  <main class="mx-auto mt-[40px] max-w-[1100px] px-4 md:mt-[120px]">
    <slot />
  </main>

  {
    relatedPosts.length > 0 && (
      <div class="mx-auto max-w-[1100px] px-4 md:mt-32">
        <h2 class="text-xl font-medium md:text-2xl">More from The Bid</h2>

        <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((post: BitsPost) => (
            <PostCard
              href={`/the-bid/${post.id}`}
              title={post.data.title}
              image={post.data.bannerImage}
              tag={post.data.tags[0]}
              contributor={post.data.author}
              pubDate={post.data.pubDate}
              readingTime={getReadingTime(post.body)}
            />
          ))}
        </div>
      </div>
    )
  }

  <div class="mt-32">
    <CTA />
    <Footer />
  </div>
</BaseLayout>
