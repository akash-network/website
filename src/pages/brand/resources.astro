---
import ResourcesCard from "@/components/brand-pages/resources-card.astro";
import Layout from "@/layouts/layout.astro";
import { getEntry } from "astro:content";

const brandResourcesPage = await getEntry("Brand_Resources_Homepage", "index");

const { title, description, cards } = brandResourcesPage.data;
---

<Layout
  title={`${title} - Akash Network`}
  description={description}
  image="/brand-resources/guidelines.png"
>
  <div class="container mt-10 space-y-4 md:mt-[60px] lg:mt-20">
    <h1
      class="text-4xl font-semibold leading-tight tracking-tight text-foreground"
    >
      {title}
    </h1>
    <p
      class="max-w-[800px] text-base font-normal text-para"
    >
      {description}
    </p>
  </div>

  <div class="container mt-10 lg:mt-20">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((card) => (
          <ResourcesCard
            title={card.title}
            description={card.description}
            buttons={card.button}
            image={card.image}
          />
        ))
      }
    </div>
  </div>
</Layout>
