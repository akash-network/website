---
import Layout from "@/layouts/layout.astro";
import TopMargin from "@/components/ui/top-margin.astro";

const tiles = [
  {
    title: "Startups",
    description:
      "Skip the sales calls and waitlists. Akash gives early-stage teams direct access to the world's GPU supply at the cost of silicon — no markups, no lock-in.",
    href: "/explore/use-cases/startups/",
    image: "/development/startups-hero.png",
  },
  {
    title: "Universities",
    description:
      "Open research needs open compute. Akash provides academic institutions with cost-effective, permissionless access to high-performance compute for AI and scientific workloads.",
    href: "/explore/use-cases/universities/",
    image: "/development/universities-hero.png",
  },
];
---

<Layout
  title="Use Cases — Akash Network"
  description="Discover how startups and universities are deploying on Akash — decentralized, cost-efficient compute for builders and researchers."
>
  <TopMargin readable>
    <div class="flex flex-col gap-16 md:gap-24">
      <div class="space-y-4">
        <h1 class="text-4xl font-semibold leading-tight tracking-tight text-foreground md:text-5xl lg:text-6xl">
          Use Cases
        </h1>
        <p class="max-w-2xl text-base font-normal leading-relaxed text-para">
          From seed-stage startups to research universities, teams are choosing Akash for permissionless access to decentralized compute.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        {tiles.map((tile) => (
          <a
            href={tile.href}
            class="group flex flex-col overflow-hidden rounded-xl border border-input bg-background transition-colors hover:bg-accent"
          >
            <div class="overflow-hidden">
              <img
                src={tile.image}
                alt={tile.title}
                class="h-[220px] w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-[1.03] group-hover:brightness-105"
              />
            </div>
            <div class="flex flex-1 flex-col gap-3 p-6">
              <h2 class="text-xl font-semibold text-foreground">{tile.title}</h2>
              <p class="text-sm font-normal leading-relaxed text-para">
                {tile.description}
              </p>
              <div class="mt-auto flex items-center gap-1 pt-4 text-sm font-medium text-foreground">
                Learn more
                <svg
                  class="h-4 w-4 translate-x-0 transition-transform duration-200 group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </TopMargin>
</Layout>
