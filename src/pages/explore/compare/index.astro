---
import Layout from "@/layouts/layout.astro";
import TopMargin from "@/components/ui/top-margin.astro";

const comparisons = [
  {
    title: "Akash vs AWS",
    description:
      "Your cloud should compete for your business. AWS sets the price — on Akash, providers bid for yours. Zero egress, no capacity reservations, no quota requests.",
    href: "/explore/compare/akash-vs-aws",
    image: "/compare/compare-vs-aws.webp",
  },
  {
    title: "Akash vs RunPod",
    description:
      "They're a broker. We're a marketplace. Bid directly on global supply instead of renting from the middle — every bid names the provider, the price, and the hardware.",
    href: "/explore/compare/akash-vs-runpod",
    image: "/compare/compare-vs-runpod.webp",
  },
  {
    title: "Akash vs Vast.ai",
    description:
      "Two open markets for GPUs. One of them can't take your machine back mid-run. Akash bids once at placement, then the lease is yours until you close it.",
    href: "/explore/compare/akash-vs-vast-ai",
    image: "/compare/compare-vs-vast-ai.webp",
  },
  {
    title: "Akash vs Lambda Labs",
    description:
      "When they're sold out, the marketplace is just getting started. Open GPU supply from independent providers — nothing signed, nothing reserved, nothing to wait for.",
    href: "/explore/compare/akash-vs-lambda-labs",
    image: "/compare/compare-vs-lambda.webp",
  },
  {
    title: "Akash vs Fly.io",
    description:
      "Fly is retiring its GPUs. Your app can stay where it is. Your model needs somewhere to go — an open market that nobody can deprecate out from under you.",
    href: "/explore/compare/akash-vs-fly-io",
    image: "/compare/compare-vs-fly-io.webp",
  },
  {
    title: "Akash vs Render",
    description:
      "Render runs your containers for you. Akash rents you the hardware to run them on — including the GPUs Render doesn't have. Market pricing on the resources you specify.",
    href: "/explore/compare/akash-vs-render",
    image: "/compare/compare-vs-render.webp",
  },
  {
    title: "Akash vs Railway",
    description:
      "Railway says to pair it with something else when you need GPUs. This is that something else — an open market where providers bid, not another rate card.",
    href: "/explore/compare/akash-vs-railway",
    image: "/compare/compare-vs-railway.webp",
  },
  {
    title: "Akash vs Heroku",
    description:
      "Heroku sells you a dyno tier. Akash sells you the hardware, at whatever the market clears at — GPUs included. Standard Docker images, no buildpacks, no forced sleep.",
    href: "/explore/compare/akash-vs-heroku",
    image: "/compare/compare-vs-heroku.webp",
  },
];
---

<Layout
  title="Compare — Akash Network"
  description="See how Akash stacks up against legacy cloud providers on price, portability, and performance."
>
  <TopMargin>
    <div class="flex flex-col gap-16 pt-4 pb-28 md:gap-24">
      <div class="space-y-4">
        <h1 class="text-4xl font-semibold leading-tight tracking-tight text-foreground md:text-5xl lg:text-6xl">
          Compare
        </h1>
        <p class="max-w-2xl text-base font-normal leading-relaxed text-para">
          Akash vs alternative cloud platforms. Side-by-side breakdowns on pricing, container portability, and infrastructure architecture.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        {comparisons.map((tile) => (
          <a
            href={tile.href}
            class="group flex flex-col overflow-hidden rounded-xl border border-input bg-background transition-colors hover:bg-accent"
          >
            <div class="overflow-hidden">
              <img
                src={tile.image}
                alt={tile.title}
                class="h-[220px] w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-[1.03] group-hover:brightness-105"
              />
            </div>
            <div class="flex flex-1 flex-col gap-3 p-6">
              <h2 class="text-xl font-semibold text-foreground">{tile.title}</h2>
              <p class="text-sm font-normal leading-relaxed text-para">{tile.description}</p>
              <div class="mt-auto flex items-center gap-1 pt-4 text-sm font-medium text-foreground">
                Read comparison
                <svg
                  class="h-4 w-4 translate-x-0 transition-transform duration-200 group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </TopMargin>
</Layout>
