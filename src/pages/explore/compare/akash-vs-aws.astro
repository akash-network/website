---
import Layout from "@/layouts/layout.astro";
import TopMargin from "@/components/ui/top-margin.astro";
import { ChevronRight } from "lucide-react";
import { FAQ } from "@/components/token-page/faq";

const parity = [
  {
    tier: "Compute Run Rate",
    aws: "EC2 (Elastic Compute Cloud)",
    equivalent: "Native OCI Containers",
    execution: "Executes container workloads directly on host hardware, removing heavy virtualization hypervisors to optimize compute path efficiency.",
  },
  {
    tier: "Orchestration",
    aws: "EKS (Elastic Kubernetes Service)",
    equivalent: "Native Kubernetes",
    execution: "Schedules your specified resource configurations directly into verified, multi-tenant cluster pools.",
  },
  {
    tier: "Silicon Allocation",
    aws: "P4d / P5 Instance Classes",
    equivalent: "Direct GPU Marketplace",
    execution: "On-demand access to enterprise H100/A100 clusters and high-density consumer hardware without upfront contracts.",
  },
  {
    tier: "Persistent Storage",
    aws: "EBS (Elastic Block Store)",
    equivalent: "Stateful NVMe Volumes",
    execution: "Attaches high-speed physical storage blocks directly to the container instance, keeping your data state persistent across system restarts.",
  },
  {
    tier: "Public Routing",
    aws: "Elastic IP Address",
    equivalent: "Static IP Leases",
    execution: "Provisions and binds fixed, public IPv4 entry points directly to your active workload, ensuring routing endpoints stay stable during updates.",
  },
  {
    tier: "Infrastructure as Code",
    aws: "CloudFormation / AWS CDK",
    equivalent: "Stack Definition Language (SDL)",
    execution: "Declares your entire structural requirements (CPU, RAM, storage, env variables) inside a single portable YAML file modeled after Docker Compose.",
  },
];

const gaps = [
  {
    title: "Stateless Microservices vs. Native Serverless",
    body: "Akash does not run a proprietary Function-as-a-Service engine matching AWS Lambda. If your application relies on event-driven, zero-scale serverless functions, you handle this by deploying open container runtimes like OpenFaaS or Knative directly inside your layout files.",
  },
  {
    title: "Cryptographic Keypairs over Centralized IAM",
    body: "The platform discards centralized root accounts, administrative login panels, and complex identity access policies. Infrastructure ownership, system adjustments, and fund lines are controlled entirely via private cryptographic keys. Administrative security is bound directly to your signature, removing the risk of credential leakages through corporate phishing or management panel vulnerabilities.",
  },
];

const faqs = [
  {
    title: "Is an open provider network stable enough for production APIs?",
    description: "Yes. You retain total programmatic control over where your code executes. By defining specific provider verification rules within your configuration file, you can instruct the network to filter out consumer hardware nodes and only accept bids from enterprise-grade, audited data centers with verified uptimes. For mission-critical production stacks, you can eliminate single points of failure by deploying your portable definition file to multiple independent providers concurrently.",
  },
  {
    title: "Do we need to buy and hold crypto assets to secure our hosting line?",
    description: "No. You can fund deployments, manage active workloads, and settle your compute costs directly using standard credit cards or stablecoins pegged 1:1 with the US Dollar. The network gateways handle all necessary background operations automatically, ensuring your infrastructure costs remain predictable, transparent, and compliant with corporate accounting workflows.",
  },
  {
    title: "What happens if a data center hosting our container drops offline?",
    description: "Every active deployment is protected by an automated network lease. If a host node fails to broadcast uptime validations or suffers a critical outage, the lease terminates and billing halts instantly. Because your entire system architecture is preserved inside your portable template file, you simply re-submit your manifest to the network to spin up a new instance on an alternate provider within minutes.",
  },
];
---

<Layout
  title="Akash vs AWS — Compare"
  description="Provision GPU clusters and container allocations directly from independent infrastructure sources. Eliminate hyperscaler margin stacking, arbitrary regional price manipulation, and restrictive volume contracts."
>
  <TopMargin>
    <div class="not-prose pb-28">

      <!-- HERO -->
      <section class="space-y-8 pt-4">
        <div class="space-y-5">
          <h1 class="max-w-2xl text-4xl font-semibold leading-tight tracking-tight text-foreground md:text-5xl lg:text-6xl">
            Compute pricing set by the market. Not a corporate boardroom.
          </h1>
          <p class="max-w-2xl text-base font-normal text-para">
            Provision high-density GPU clusters and on-demand container allocations directly from independent infrastructure providers. Eliminate hyperscaler margin stacking, regional price variances, and restrictive volume contracts.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/pricing/gpus"
            class="inline-flex items-center rounded-md border border-foreground bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-80"
          >
            View Live Marketplace Rates <ChevronRight size={14} className="ml-1.5" />
          </a>
          <a
            href="https://akash.network/docs/deployments/overview/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-md border bg-background px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-badgeColor"
          >
            Review Service Parity Docs
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1.5"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        </div>
        <div class="group mt-2 overflow-hidden rounded-xl">
          <img
            src="/compare/hero-vs-aws.png"
            alt="Akash vs AWS"
            class="h-[240px] w-full object-cover md:h-[380px] grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-[1.03] group-hover:brightness-105"
          />
        </div>
      </section>

      <!-- CORE ECONOMICS -->
      <section class="mt-20 space-y-10 md:mt-44">
        <div class="space-y-4">
          <h2 class="font-sans text-3xl !font-medium leading-snug tracking-tight text-foreground md:text-4xl">
            The Core Economics
          </h2>
          <p class="max-w-2xl text-base font-normal text-para">
            Legacy clouds price compute top-down to offset real estate acquisition, multi-layered operations teams, and institutional margin targets. Akash operates as a peer-to-peer brokerage ledger. Independent data centers with verified idle capacity bid directly against one another to win your container workloads, dropping resource costs down to the native expense of hardware depreciation and local power.
          </p>
        </div>
        <div class="overflow-hidden rounded-xl border border-border">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="border-b border-border bg-gray-50 dark:bg-background2">
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-para"></th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-para">AWS EC2 (c5.large)</th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-foreground">Akash Network</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-border">
                <td class="px-6 py-4 text-sm font-medium text-foreground">Allocation</td>
                <td class="px-6 py-4 text-sm text-para">2 vCPU / 4 GB Dedicated RAM</td>
                <td class="px-6 py-4 text-sm text-foreground">2 vCPU / 4 GB Dedicated RAM</td>
              </tr>
              <tr class="border-b border-border">
                <td class="px-6 py-4 text-sm font-medium text-foreground">Networking</td>
                <td class="px-6 py-4 text-sm text-para">Base run rate + $0.09/GB public egress</td>
                <td class="px-6 py-4 text-sm text-foreground">Bandwidth included in host bid</td>
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm font-medium text-foreground">Monthly Cost</td>
                <td class="px-6 py-4 text-sm text-para">~$61.20 + unpredictable usage fees</td>
                <td class="px-6 py-4 text-sm font-semibold text-foreground">~$6.50 average settlement</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- STRUCTURAL BOTTLENECKS -->
      <section class="mt-20 md:mt-44">
        <h2 class="font-sans text-3xl !font-medium leading-snug tracking-tight text-foreground md:text-4xl">
          Architectural Distinctions
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-12">
          <div class="rounded-xl border border-border bg-card p-6 flex flex-col gap-3">
            <h3 class="text-xl font-semibold leading-snug text-foreground">
              Direct Access to High-Density Hardware
            </h3>
            <p class="text-sm leading-relaxed text-para">
              Securing enterprise accelerators like NVIDIA H100 or A100 nodes on AWS requires navigating intensive procurement workflows: multi-year commitments, upfront capacity reservations, and persistent sales negotiations. Akash unifies global infrastructure availability into a single network directory. You can provision dedicated GPU resources by the hour using standard configuration files, bypassing manual account verification entirely.
            </p>
          </div>
          <div class="rounded-xl border border-border bg-card p-6 flex flex-col gap-3">
            <h3 class="text-xl font-semibold leading-snug text-foreground">
              Transparent Network Egress Costing
            </h3>
            <p class="text-sm leading-relaxed text-para">
              Traditional hyperscalers build financial barriers around your data. While data ingress is generally free, moving model weights, training logs, or dataset checkpoints out of their private network incurs significant data egress fees. This creates a lock-in mechanism that penalizes multi-cloud strategies. Akash network providers bundle data transfer bandwidth directly into their competitive compute bids, allowing teams to stream large data pipelines without variable trailing fees.
            </p>
          </div>
        </div>
      </section>

      <!-- SERVICE PARITY INDEX -->
      <section class="mt-20 space-y-10 md:mt-44">
        <div class="space-y-4">
          <h2 class="font-sans text-3xl !font-medium leading-snug tracking-tight text-foreground md:text-4xl">
            Service Parity Index
          </h2>
          <p class="max-w-2xl text-base font-normal text-para">
            You do not need to rewrite service layers or modify application logic. The platform uses the exact cloud-native standards your engineering team already deploys in production, mapping proprietary APIs to open-source alternatives.
          </p>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[800px] border-collapse text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="w-[18%] pb-3 text-left text-sm font-medium text-para">Infrastructure Tier</th>
                <th class="w-[18%] pb-3 pl-6 text-left text-sm font-medium text-para">Legacy AWS</th>
                <th class="w-[20%] pb-3 pl-6 text-left text-sm font-medium text-foreground">Marketplace Equivalent</th>
                <th class="pb-3 pl-6 text-left text-sm font-medium text-para">Technical Execution</th>
              </tr>
            </thead>
            <tbody>
              {parity.map((row) => (
                <tr class="border-b border-border">
                  <td class="py-5 pr-6 align-top text-sm font-semibold text-foreground">{row.tier}</td>
                  <td class="py-5 pl-6 pr-6 align-top text-sm font-normal leading-relaxed text-para">{row.aws}</td>
                  <td class="py-5 pl-6 pr-6 align-top text-sm font-normal leading-relaxed text-foreground">{row.equivalent}</td>
                  <td class="py-5 pl-6 align-top text-sm font-normal leading-relaxed text-para">{row.execution}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- SYSTEM GAP ANALYSIS -->
      <section class="mt-20 space-y-10 md:mt-44">
        <h2 class="font-sans text-3xl !font-medium leading-snug tracking-tight text-foreground md:text-4xl">
          System Gap Analysis
        </h2>
        <div class="grid gap-8 md:grid-cols-2">
          {gaps.map((item) => (
            <div class="space-y-3">
              <h3 class="text-base font-semibold text-foreground">{item.title}</h3>
              <p class="text-sm font-normal leading-relaxed text-para">{item.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ -->
      <section class="mt-20 md:mt-44">
        <div class="pb-4">
          <h2 class="font-sans text-3xl !font-medium leading-snug tracking-tight text-foreground md:text-4xl">
            FAQs
          </h2>
        </div>
        <FAQ faqs={faqs} client:load />
      </section>

      <!-- PAGE CLOSER -->
      <section class="mt-20 flex flex-col items-center space-y-8 text-center md:mt-44">
        <div class="space-y-5">
          <h2 class="text-5xl font-semibold leading-tight tracking-tight text-foreground md:text-6xl lg:text-7xl">
            Start Building
          </h2>
          <p class="max-w-2xl text-base font-normal text-para">
            Migrate your containerized pipelines to an open hardware marketplace. Maintain absolute configuration control without legacy vendor markups.
          </p>
        </div>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="https://console.akash.network"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-md border border-foreground bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-80"
          >
            Launch Your Workload <ChevronRight size={14} className="ml-1.5" />
          </a>
          <a
            href="https://github.com/akash-network/awesome-akash"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-md border bg-background px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-badgeColor"
          >
            Explore SDL Templates
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1.5"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        </div>
      </section>

    </div>
  </TopMargin>
</Layout>
