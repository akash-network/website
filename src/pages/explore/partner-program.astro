---
import Layout from "@/layouts/layout.astro";
import TopMargin from "@/components/ui/top-margin.astro";
import { ChevronRight } from "lucide-react";
import grantsImage from "../../content/Development_Page/funding-program/card1.png";

const docSections = [
  {
    title: "Blockchain SDK Documentation",
    rows: [
      { name: "SDK Overview", desc: "Official Go and JavaScript/TypeScript SDKs", href: "https://akash.network/docs/api-documentation/sdk/" },
      { name: "Quick Start", desc: "Deploy your first application programmatically", href: "https://akash.network/docs/api-documentation/sdk/quick-start/" },
      { name: "API Reference", desc: "Complete SDK documentation and methods", href: "https://akash.network/docs/api-documentation/sdk/api-reference/" },
      { name: "SDK Examples", desc: "Code examples for common tasks", href: "https://akash.network/docs/api-documentation/sdk/examples/" },
      { name: "AuthZ & Fee Grants", desc: "Manage permissions and sponsored transactions", href: "https://akash.network/docs/api-documentation/sdk/authz-feegrant/" },
    ],
  },
  {
    title: "Deployment REST API Documentation",
    rows: [
      { name: "API Overview", desc: "REST API for credit card deployments via Console", href: "https://akash.network/docs/api-documentation/console-api/" },
      { name: "Getting Started", desc: "Set up authentication and make your first API call", href: "https://akash.network/docs/api-documentation/console-api/getting-started/" },
      { name: "API Reference", desc: "Complete endpoint documentation", href: "https://akash.network/docs/api-documentation/console-api/api-reference/" },
    ],
  },
  {
    title: "Console API — Network Data",
    rows: [
      { name: "Console API — Network Data", desc: "Indexed data: providers, GPU, stats. Not a node.", href: "https://akash.network/docs/api-documentation/rest-api/" },
      { name: "Providers API", desc: "Query provider details, specs, and availability", href: "https://akash.network/docs/api-documentation/rest-api/providers-api/" },
      { name: "GPU Availability Guide", desc: "Find and filter GPU resources across providers", href: "https://akash.network/docs/api-documentation/rest-api/gpu-availability-guide/" },
    ],
  },
];
---

<Layout
  title="Partner Program — Akash Network"
  description="Co-develop native developer tools, deploy verified data center capacity, or architect production container runtimes alongside the global Akash ecosystem."
>
  <TopMargin>
    <div class="not-prose pb-28">

      <!-- HERO -->
      <section class="space-y-5 pt-4">
        <h1 class="max-w-2xl text-4xl font-semibold leading-tight tracking-tight text-foreground md:text-5xl lg:text-6xl">
          The Open Cloud Partner Program
        </h1>
        <p class="max-w-2xl text-base font-normal text-para">
          Co-develop native developer tools, deploy verified data center capacity, or architect production container runtimes alongside the global Akash ecosystem.
        </p>
      </section>

      <!-- HOW THE NETWORK WORKS -->
      <section class="mt-20 md:mt-28">
        <h2 class="font-sans text-3xl !font-medium leading-snug tracking-tight text-foreground md:text-4xl">
          The Infrastructure Framework
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-16">
          <div class="rounded-xl border border-border bg-card p-6 flex flex-col gap-4">
            <h3 class="text-xl font-semibold leading-snug text-foreground">Standard Kubernetes Deployment</h3>
            <p class="text-sm leading-relaxed text-para">
              Providers run standard, unmodified Kubernetes clusters on their hardware. When a developer submits an OCI container manifest, it maps directly to your existing infrastructure setup without requiring custom hypervisors or proprietary software layers.
            </p>
          </div>
          <div class="rounded-xl border border-border bg-card p-6 flex flex-col gap-4">
            <h3 class="text-xl font-semibold leading-snug text-foreground">Automated Revenue Generation</h3>
            <p class="text-sm leading-relaxed text-para">
              Our automated matching engine routes incoming compute demand directly to your available nodes. Your infrastructure automatically evaluates workload requirements and delivers competitive pricing to secure leases, turning idle silicon into predictable revenue without manual sales intervention.
            </p>
          </div>
          <div class="rounded-xl border border-border bg-card p-6 flex flex-col gap-4">
            <h3 class="text-xl font-semibold leading-snug text-foreground">Enterprise Verification & Audits</h3>
            <p class="text-sm leading-relaxed text-para">
              Maintain your premium positioning. Independent network auditors verify your data center tiers, physical location, and hardware specifications (like dedicated H100 arrays). This allows high-compliance enterprise tenants to target your facility exclusively for large-scale production workloads.
            </p>
          </div>
        </div>
      </section>

      <!-- ECOSYSTEM SUCCESS STORY -->
      <section class="mt-20 md:mt-44">
        <div class="grid items-center gap-8 md:gap-16 md:grid-cols-2">

          <!-- Left: Content -->
          <div class="space-y-6">
            <div class="space-y-4">
              <span class="inline-flex items-center rounded-full border border-border px-3 py-[3px] text-sm font-normal text-foreground">Ecosystem Partner Story</span>
              <h3 class="font-sans text-3xl !font-medium leading-snug tracking-tight text-foreground md:text-4xl">
                From Tooling to Protocol Acquisition
              </h3>
              <p class="text-base font-normal text-para">
                Cloudmos joined the ecosystem as an independent team engineering utilities to simplify remote container deployment management. By developing Cloudmos Alerts, Akashlytics, and Cloudmos Deploy, the team built the primary console interface utilized by network tenants to launch and manage active workloads.
              </p>
              <p class="text-base font-normal text-para">
                Overclock Labs (Founders of Akash) acquired Cloudmos to integrate this framework directly into the core protocol software layer. Following the acquisition, the entire codebase was migrated to the public Akash Network GitHub repository, giving developers a production-grade blueprint to audit, fork, and build custom web deployment interfaces.
              </p>
            </div>
            <div class="flex flex-col gap-3 border-t border-border pt-5 sm:grid sm:grid-cols-2 sm:gap-4">
              <div class="space-y-0.5">
                <p class="text-xs font-medium uppercase tracking-widest text-para">Core Contribution</p>
                <p class="text-sm font-medium text-foreground">Cloudmos Deploy</p>
                <p class="text-sm font-medium text-foreground">Akashlytics</p>
                <p class="text-sm font-medium text-foreground">Deployment Alerts</p>
              </div>
              <div class="space-y-0.5">
                <p class="text-xs font-medium uppercase tracking-widest text-para">Outcome</p>
                <p class="text-sm font-medium text-foreground">Acquired by</p>
                <p class="text-sm font-medium text-foreground">Overclock Labs</p>
                <p class="text-sm font-medium text-foreground">(Founders of Akash)</p>
              </div>
            </div>
          </div>

          <!-- Right: Image -->
          <div class="group overflow-hidden rounded-xl">
            <img
              src="/images/partners-story.webp"
              alt="Cloudmos — Ecosystem Partner Story"
              class="aspect-square w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-[1.03] group-hover:brightness-105"
            />
          </div>

        </div>
      </section>

      <!-- WAYS TO PARTNER -->
      <section class="mt-20 md:mt-44">
        <h2 class="font-sans text-3xl !font-medium leading-snug tracking-tight text-foreground md:text-4xl">
          Ways to Partner
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-16">
          <div class="rounded-xl border border-border bg-card p-6 flex flex-col gap-4">
            <h3 class="text-xl font-semibold leading-snug text-foreground">Build Software Tooling</h3>
            <p class="text-sm leading-relaxed text-para">
              Integrate developer utilities, deployment consoles, or AI orchestrators into the network ecosystem. Access technical documentation to co-develop tooling that simplifies container resource allocation.
            </p>
          </div>
          <div class="rounded-xl border border-border bg-card p-6 flex flex-col gap-4">
            <h3 class="text-xl font-semibold leading-snug text-foreground">Supply Compute Capacity</h3>
            <p class="text-sm leading-relaxed text-para">
              Connect commercial colocation facilities or server clusters to the open network. Monetize available compute via automated demand matching while retaining complete infrastructure control.
            </p>
          </div>
          <div class="rounded-xl border border-border bg-card p-6 flex flex-col gap-4">
            <h3 class="text-xl font-semibold leading-snug text-foreground">Consult & Deploy</h3>
            <p class="text-sm leading-relaxed text-para">
              Provide engineering architecture, workload migration plans, and managed services. Help enterprise clients scale containerized application stacks and eliminate proprietary vendor lock-in.
            </p>
          </div>
        </div>
      </section>

      <!-- ECOSYSTEM GRANTS -->
      <section class="mt-20 md:mt-44">
        <div class="grid items-center gap-8 md:gap-16 md:grid-cols-2">
          <div class="group overflow-hidden rounded-xl">
            <img
              src={grantsImage.src}
              alt="Akash Ecosystem Grants"
              class="aspect-square w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-[1.03] group-hover:brightness-105"
            />
          </div>
          <div class="space-y-6">
            <div class="space-y-4">
              <h2 class="font-sans text-3xl !font-medium leading-snug tracking-tight text-foreground md:text-4xl">
                Ecosystem Grants
              </h2>
              <p class="text-base font-normal text-para">
                We invest in the people who build the roads. If you are developing open-source tools, infrastructure, or specialized interfaces for the Akash Network, the grant program provides the capital to fund your development.
              </p>
              <p class="text-base font-normal text-para">
                Whether you are launching a new integration, expanding hardware supply, or contributing core protocol improvements, the grants program is designed to match network needs with your specific skill set.
              </p>
            </div>
            <a
              href="/grants/"
              class="inline-flex items-center rounded-md border bg-background px-4 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-badgeColor"
            >
              Explore Grants <ChevronRight size={14} className="ml-1.5" />
            </a>
          </div>
        </div>
      </section>

      <!-- SDK & API DOCS -->
      <section class="mt-20 space-y-16 md:mt-44">
        <h2 class="max-w-xl font-sans text-3xl !font-medium leading-snug tracking-tight text-foreground md:text-4xl">
          Integrate Akash into your applications with SDKs and APIs
        </h2>
        {docSections.map((section) => (
          <div>
            <div class="flex items-center gap-8 pb-3">
              <span class="w-72 shrink-0 text-sm font-medium text-para">{section.title}</span>
              <span class="hidden flex-1 text-sm font-medium text-para sm:block">Description</span>
            </div>
            <div class="border-t">
              {section.rows.map((r) => (
                <div class="flex flex-col gap-3 border-b py-5 sm:flex-row sm:items-center sm:gap-8">
                  <div class="flex w-full flex-col gap-1 sm:w-72 sm:shrink-0">
                    <a
                      href={r.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-base font-medium text-foreground hover:underline"
                    >
                      {r.name}
                    </a>
                    <p class="text-sm text-para sm:hidden">{r.desc}</p>
                  </div>
                  <p class="hidden flex-1 text-sm text-para sm:block">{r.desc}</p>
                  <a
                    href={r.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-fit shrink-0 inline-flex items-center rounded-md border bg-background px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:bg-badgeColor"
                  >
                    View Docs<ChevronRight size={14} className="ml-1" />
                  </a>
                </div>
              ))}
            </div>
          </div>
        ))}
      </section>

      <!-- PAGE CLOSER -->
      <section class="mt-20 flex flex-col items-center space-y-8 text-center md:mt-44">
        <div class="space-y-5">
          <h2 class="text-5xl font-semibold leading-tight tracking-tight text-foreground md:text-6xl lg:text-7xl">
            Become a Partner
          </h2>
          <p class="max-w-2xl text-base font-normal text-para">
            Coordinate with our ecosystem team to discover custom integration paths, infrastructure deployment frameworks, or certified service tracks.
          </p>
        </div>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="/gpus-on-demand"
            class="inline-flex items-center rounded-md border border-foreground bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-80"
          >
            Apply Now
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1.5">
              <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
            </svg>
          </a>
          <a
            href="/gpus-on-demand"
            class="inline-flex items-center rounded-md border bg-background px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-badgeColor"
          >
            Get in Touch
          </a>
        </div>
      </section>

    </div>
  </TopMargin>
</Layout>
