---
import BitsFilterBar from "@/components/blog/bits-filter-bar.astro";
import BlogPosts from "@/components/blog/blog-posts.astro";
import { POSTS_PER_PAGE } from "@/components/blog/blogUi";
import PostCard from "@/components/cards/post-card.astro";
import Layout from "@/layouts/layout.astro";
import { getBitsPosts } from "@/utils/bitsTaxonomy";
import type { PaginateFunction } from "astro";
import type { CollectionEntry } from "astro:content";

type BitsPost = CollectionEntry<"Bits">;

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction;
}) {
  return paginate(await getBitsPosts(), { pageSize: POSTS_PER_PAGE });
}

const { page } = Astro.props;
---

<Layout
  title="The Bid by Akash Network"
  description="Quick-read technical insights on the AI Space by Akash."
>
  <div class="container mt-10 md:mt-16">
    <BitsFilterBar />

    <BlogPosts page={page}>
      {
        page.data.map((post: BitsPost) => (
          <PostCard
            href={`/the-bid/${post.id}`}
            title={post.data.title}
            image={post.data.bannerImage}
            tag={post.data.tags[0]}
            contributor={post.data.author}
            pubDate={post.data.pubDate}
            hideTag
            hideDate
            hideAuthor
          />
        ))
      }
    </BlogPosts>
  </div>
</Layout>
