---
import BitsSearchDialog from "@/components/blog/bits-search-dialog";
import Pagination from "@/components/pagination.astro";
import BitsTag from "@/components/ui/bits-tag.astro";
import FormattedDate from "@/components/formatted-date.astro";
import Layout from "@/layouts/layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

type BitsPost = CollectionEntry<"Bits">;

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = (await getCollection("Bits"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => {
      return (
        new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
      );
    });

  const tags: string[] = [];
  posts.forEach((post) => {
    post.data.tags.forEach((tag: string) => {
      if (!tags.includes(tag)) tags.push(tag);
    });
  });

  return paginate(posts, {
    props: { tags },
    pageSize: 12,
  });
}

const { page, tags } = Astro.props;
const pathName = Astro.url.pathname.split("/");
---

<Layout
  title="The Bid by Akash Network"
  description="Quick-read technical insights on the AI Space by Akash."
>
  <div class="container mt-[72px] md:mt-[96px]">
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
      The Bid
    </h1>
    <p class="mb-10 mt-4 text-base text-linkText md:text-lg">
      Quick-read technical insights on the AI Space by Akash
    </p>

    <div
      class="flex flex-col items-start justify-between gap-x-5 border-b pb-5 lg:flex-row lg:border-none"
    >
      <div
        class="sidebar-scroll flex max-w-full items-center justify-start gap-2 overflow-auto pb-1"
      >
        <BitsTag
          active={pathName[1]?.toLowerCase() === "the-bid" && !pathName[2]}
          href="/the-bid"
        >
          All Posts
        </BitsTag>

        {
          tags.map((tag: string) => (
            <BitsTag
              href={`/the-bid/${tag.toLowerCase().replaceAll(" ", "-")}/1`}
              active={
                pathName[2]?.toLowerCase() ===
                tag.toLowerCase().replaceAll(" ", "-")
              }
            >
              {tag.charAt(0).toUpperCase() + tag.slice(1)}
            </BitsTag>
          ))
        }
      </div>

      <div class="hidden lg:block">
        <BitsSearchDialog client:load />
      </div>
    </div>

    <div class="mt-5 flex justify-end lg:hidden">
      <BitsSearchDialog client:load />
    </div>

    <div
      class="mt-10 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:mt-[80px] lg:grid-cols-3 lg:gap-16"
    >
      {
        page.data.map((post: BitsPost) => (
          <a class="flex cursor-pointer" href={`/the-bid/${post.id}`}>
            <div class="group flex flex-col duration-100 ease-in">
              <div class="aspect-video overflow-hidden rounded-lg bg-badgeColor">
                {post.data.bannerImage ? (
                  <Image
                    src={post.data.bannerImage}
                    alt={`Banner image for ${post.data.title}`}
                    width={1200}
                    height={675}
                    format="webp"
                    class="h-full w-full object-cover shadow-sm transition-all duration-500 ease-in-out group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="h-full w-full bg-gradient-to-br from-primary/20 to-badgeColor" />
                )}
              </div>

              <div class="mt-4">
                <p class="text-2xs font-medium text-linkText md:text-sm">
                  By {post.data.author}
                </p>

                <h3 class="mt-2 line-clamp-2 text-base font-semibold md:mt-4 md:text-xl">
                  {post.data.title}
                </h3>

                <p class="mt-3 line-clamp-2 text-xs text-linkText md:mt-3 md:text-sm">
                  {post.data.description}
                </p>

                <div class="mt-4 flex items-center justify-between">
                  <p class="text-2xs font-medium text-linkText md:text-sm">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                  {post.data.tags[0] && (
                    <span class="inline-flex items-center rounded-full bg-[hsl(0,0%,94%)] px-2.5 py-0.5 text-xs font-medium text-[hsl(0,0%,20%)] dark:bg-[hsl(0,0%,22%)] dark:text-[hsl(0,0%,88%)]">
                      {post.data.tags[0]}
                    </span>
                  )}
                </div>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <Pagination page={page} />
  </div>
</Layout>
