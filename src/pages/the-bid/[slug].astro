---
import CalloutsClasses from "@/components/callouts-classes.astro";
import BitsPostDate from "@/components/blog/bits-post-date.astro";
import FormattedDate from "@/components/formatted-date.astro";
import BeforeFaq from "@/components/the-bid/before-faq.astro";
import CtaCard from "@/components/the-bid/cta-card.astro";
import CtaStrip from "@/components/the-bid/cta-strip.astro";
import RunItOnAkash from "@/components/the-bid/run-it-on-akash.astro";
import BitsLayout from "@/layouts/bits-layout.astro";
import { bitsUpdatedDate } from "@/lib/bits-dates";
import { blogPostProseClasses } from "@/lib/prose-classes";
import { bidCta } from "@/lib/the-bid-cta";
import { toCategorySlug } from "@/utils/blogTaxonomy";
import { getReadingTime } from "@/utils/readingTime";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("Bits");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body);
const updated = bitsUpdatedDate(post.data);

const tag = post.data.tags[0];
const tagLabel = tag && tag.charAt(0).toUpperCase() + tag.slice(1);

// Parse "## FAQ" / "## FAQs" body section (format: **Question?** Answer text)
// into Q&A pairs for FAQPage structured data. Mirrors the heading/paragraph
// detection in src/lib/markdown/autoFaqAccordion.ts, but reads the raw
// markdown body directly since the accordion transform isn't exposed on
// post.data.
function extractFaqs(body: string): { question: string; answer: string }[] {
  const headingMatch = body.match(/^##\s+FAQs?\s*$/im);
  if (!headingMatch || headingMatch.index === undefined) return [];

  const afterHeading = body.slice(headingMatch.index + headingMatch[0].length);
  const nextHeadingMatch = afterHeading.match(/^#{1,6}\s+/m);
  const section = nextHeadingMatch
    ? afterHeading.slice(0, nextHeadingMatch.index)
    : afterHeading;

  return section
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean)
    .map((paragraph) => paragraph.match(/^\*\*(.+?)\*\*\s*(.*)$/s))
    .filter((match): match is RegExpMatchArray => match !== null)
    .map((match) => ({
      question: match[1].trim(),
      answer: match[2]
        .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
        .replace(/\*\*/g, "")
        // Drop markdown backslash escapes (e.g. "\$6" -> "$6").
        .replace(/\\([\\`*_{}\[\]()#+\-.!$])/g, "$1")
        .replace(/\s+/g, " ")
        .trim(),
    }))
    .filter((faq) => faq.question && faq.answer);
}

const siteUrl = "https://akash.network";
const postUrl = new URL(`/the-bid/${post.id}/`, Astro.site).toString();
const listingUrl = new URL("/the-bid/", Astro.site).toString();
const faqs = extractFaqs(post.body ?? "");
const cta = bidCta(post.data.title);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "Akash Network",
      url: siteUrl,
      logo: `${siteUrl}/favicon.ico`,
    },
    {
      "@type": "Article",
      "@id": `${postUrl}#article`,
      headline: post.data.title,
      description: post.data.metaDescription ?? post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (updated ?? post.data.pubDate).toISOString(),
      author: {
        "@type": "Person",
        name: post.data.author,
      },
      publisher: { "@id": `${siteUrl}/#organization` },
      mainEntityOfPage: postUrl,
      ...(post.data.bannerImage
        ? { image: new URL(post.data.bannerImage.src, Astro.site).toString() }
        : {}),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${postUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: "The Bid", item: listingUrl },
        {
          "@type": "ListItem",
          position: 3,
          name: post.data.title,
          item: postUrl,
        },
      ],
    },
    ...(faqs.length > 0
      ? [
          {
            "@type": "FAQPage",
            "@id": `${postUrl}#faq`,
            mainEntity: faqs.map((faq) => ({
              "@type": "Question",
              name: faq.question,
              acceptedAnswer: { "@type": "Answer", text: faq.answer },
            })),
          },
        ]
      : []),
  ],
};

// Escape "<" so a literal "</script>" inside any field can't close the tag early.
const jsonLdScript = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<BitsLayout
  image={post.data.bannerImage?.src}
  title={post.data.metaTitle ?? post.data.title}
  description={post.data.metaDescription ?? post.data.description}
>
  <script is:inline type="application/ld+json" set:html={jsonLdScript} />

  <!-- Header, banner and body as on blog posts (src/pages/blog/[slug].astro) -->
  <div class="grid grid-cols-12 md:gap-x-10 lg:gap-x-16">
    <header class="col-span-12 md:col-span-8">
      <!-- shadcn/ui Breadcrumb with a slash separator -->
      <nav aria-label="Breadcrumb">
        <ol
          class="flex flex-wrap items-center gap-2 text-sm text-neutral-600 dark:text-neutral-400"
        >
          <li>
            <a href="/the-bid" class="transition-colors hover:text-foreground">
              The Bid
            </a>
          </li>
          {
            tag && (
              <>
                <li role="presentation" aria-hidden="true">
                  /
                </li>
                <li>
                  <a
                    href={`/the-bid/${toCategorySlug(tag)}/1`}
                    class="transition-colors hover:text-foreground"
                  >
                    {tagLabel}
                  </a>
                </li>
              </>
            )
          }
        </ol>
      </nav>

      <h1
        class="mt-3 text-[40px] !font-[450] leading-[48px] tracking-[-0.06em] md:text-5xl md:leading-[56px]"
      >
        {post.data.title}
      </h1>

      <p class="mt-5 text-sm text-foreground">By {post.data.author}</p>

      <!-- From md up, the dates and reading time sit in the sidebar. -->
      <p
        class="mt-2 flex items-center gap-2 text-sm text-muted-foreground md:hidden"
      >
        <BitsPostDate
          pubDate={post.data.pubDate}
          lastUpdated={post.data.lastUpdated}
          variant="card"
        />
        {
          readingTime && (
            <>
              <span
                aria-hidden="true"
                class="size-1 rounded-full bg-current opacity-50"
              />
              {readingTime} min read
            </>
          )
        }
      </p>
    </header>
  </div>

  <div class="mt-8 grid grid-cols-12 md:gap-x-10">
    <article class="col-span-12 md:col-span-8">
      {
        post.data.bannerImage && (
          <div>
            <Image
              src={post.data.bannerImage}
              alt={`Banner image for the post ${post.data.title}`}
              width={1200}
              format="webp"
              class="inset-0 aspect-video bg-gray-200 object-cover"
              loading="lazy"
              quality="max"
            />
          </div>
        )
      }

      <CtaStrip cta={cta} postId={post.id} class="mt-6 md:hidden" />

      <article class={blogPostProseClasses}>
        <BeforeFaq>
          <Content />
          <RunItOnAkash slot="insert" cta={cta} postId={post.id} />
        </BeforeFaq>
      </article>
    </article>

    <!-- Sticky so the rent card stays in view while reading -->
    <aside
      class="sticky top-28 col-span-4 hidden space-y-8 self-start md:block"
    >
      <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
        <dt class="text-muted-foreground">Published</dt>
        <dd class="text-foreground">
          <FormattedDate date={post.data.pubDate} />
        </dd>
        {
          updated && (
            <>
              <dt class="text-muted-foreground">Updated</dt>
              <dd class="text-foreground">
                <FormattedDate date={updated} />
              </dd>
            </>
          )
        }
        {
          readingTime && (
            <>
              <dt class="text-muted-foreground">Reading time</dt>
              <dd class="text-foreground">{readingTime} min read</dd>
            </>
          )
        }
      </dl>

      <CtaCard cta={cta} postId={post.id} />
    </aside>
  </div>

  <CalloutsClasses />
</BitsLayout>
