---
import { GpuContactForm } from "@/components/gpus-on-demand/GpuContactForm";

import Layout from "@/layouts/layout.astro";
import "@/styles/globals.css";
---

<Layout
  image="/images/meta-images/gpu-on-demand.PNG"
  title="Get Access to GPUs On Demand"
  description="Need affordable, high-performance GPU compute? From training models to running inference or deploying a containerized apps Akash covers all your compute needs."
>
  <section
    class="container flex min-h-screen flex-col items-start gap-8 pt-8 lg:grid lg:grid-cols-2 lg:gap-20 2xl:gap-16 2xl:pt-14"
  >
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-4">
        <h1
          class="text-3xl !font-semibold leading-[1.3] 2xl:text-5xl 2xl:leading-[1.2]"
        >
          Get Access to<br /> GPUs On Demand
        </h1>
        <p
          class="text-base leading-relaxed text-zinc-500 dark:text-zinc-400 md:text-lg"
        >
          Need affordable, high-performance GPU compute? From training models to
          running inference or deploying a containerized apps Akash covers all
          your compute needs.
        </p>
        <p
          class="text-base leading-relaxed text-zinc-500 dark:text-zinc-400 md:text-lg"
        >
          This quick form helps us understand your needs so we can help you get
          started.
        </p>
      </div>
      <div class="aspect-video w-full overflow-hidden rounded-xl lg:w-4/5">
        <video
          src="/gpus-on-demand/hero.mp4"
          autoplay
          loop
          muted
          playsinline
          aria-hidden="true"
          class="h-full w-full object-cover"></video>
      </div>
    </div>
    <div class="flex w-full">
      <GpuContactForm client:load />
    </div>
  </section>
</Layout>
