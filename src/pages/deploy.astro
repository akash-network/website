---
import { ConsoleTour } from "@/components/deploy-page/tour/ConsoleTour";
import { loadNetworkSnapshot } from "@/components/deploy-page/tour/snapshot";
import MoreFromAkash from "@/components/deploy-page/MoreFromAkash.astro";
import { ConsoleVideos } from "@/components/deploy-page/ConsoleVideos";
import Layout from "@/layouts/layout.astro";
import { getEntry } from "astro:content";
import { ArrowRight, ArrowUpRight, Check } from "lucide-react";

const deployPage = await getEntry("Deploy_Homepage", "index");
if (!deployPage) throw new Error("Missing Deploy_Homepage content entry");

const {
  pageTitle,
  heroSection,
  cloudmosResourcesSection,
  additionalDeploymentSection,
} = deployPage.data;

// Provider locations and counts for the tour, fetched at build time.
const snapshot = await loadNetworkSnapshot();
---

<Layout
  title={pageTitle}
  image="/meta-images/deploy.webp"
  description={heroSection.description}
  classname="bg-background"
>
  <section class="container-wide pt-10 text-center md:pt-16">
    <h1
      class="mx-auto max-w-[860px] text-4xl !font-semibold leading-[1.05] tracking-tighter text-foreground md:text-6xl"
    >
      <Fragment set:html={heroSection.title} />
    </h1>
    <p
      class="mx-auto mt-5 max-w-[620px] text-base leading-relaxed text-para md:text-lg"
    >
      {heroSection.description}
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={heroSection.button.link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-10 items-center gap-1.5 rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
      >
        {heroSection.button.label}
        <ArrowUpRight className="h-4 w-4" />
      </a>
      <a
        href="/docs/getting-started/quick-start/"
        class="inline-flex h-10 items-center rounded-md border bg-background px-5 text-sm font-medium text-foreground transition-colors hover:bg-accent"
      >
        Read the docs
      </a>
    </div>
  </section>

  <section class="container-wide mt-12 md:mt-16" aria-label="Product tour">
    <ConsoleTour client:load snapshot={snapshot} />
    <p class="mt-3 text-center text-xs text-muted-foreground">
      Runs in your browser. GPU availability and price ranges are live from the
      Akash network; accounts, providers and bids are illustrative.
    </p>
  </section>

  <section class="container-wide mt-12 md:mt-16">
    <ul
      class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border bg-[hsl(216,11%,91%)] dark:bg-[hsl(0,0%,18%)] sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        heroSection.featureList.map((feature) => (
          <li class="flex items-center gap-3 bg-background px-5 py-4 text-sm font-medium text-foreground">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-foreground text-background">
              <Check className="h-3 w-3" />
            </span>
            {feature}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container-wide mt-20 md:mt-28">
    <h2
      class="text-2xl font-semibold tracking-tight text-foreground md:text-4xl"
    >
      {additionalDeploymentSection.title}
    </h2>
    <p class="mt-3 max-w-[560px] text-sm text-para md:text-base">
      Console is the quickest way in. When you want to automate, script or hold
      your own keys, the same network is a request away.
    </p>
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        additionalDeploymentSection.resources.map((resource) => (
          <a
            href={resource.link}
            class="group flex flex-col rounded-lg border bg-background p-5 transition-colors hover:bg-accent/40 dark:hover:bg-card"
          >
            <h3 class="text-base font-semibold text-foreground">
              {resource.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-para">
              {resource.content}
            </p>
            <span class="mt-auto inline-flex items-center gap-1 pt-6 text-sm font-medium text-foreground">
              Learn more
              <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container-wide mt-16 md:mt-24">
    <h2
      class="text-2xl font-semibold tracking-tight text-foreground md:text-4xl"
    >
      {cloudmosResourcesSection.title}
    </h2>
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        cloudmosResourcesSection.cards.map((card) => (
          <a
            href={card.link}
            class="group flex flex-col rounded-lg border bg-background p-5 transition-colors hover:bg-accent/40 dark:hover:bg-card"
          >
            <h3 class="text-base font-semibold text-foreground">
              {card.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-para">
              {card.description}
            </p>
            <span class="mt-auto inline-flex items-center gap-1 pt-6 text-sm font-medium text-foreground">
              {card.linkLabel}
              <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section
    class="container-wide mt-16 md:mt-24"
    aria-labelledby="console-videos"
  >
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <div>
        <h2
          id="console-videos"
          class="text-2xl font-semibold tracking-tight text-foreground md:text-4xl"
        >
          Watch the tutorials
        </h2>
        <p class="mt-3 max-w-[560px] text-sm text-para md:text-base">
          Short walkthroughs of Akash Console, each under three minutes, from
          the Akash Network YouTube channel.
        </p>
      </div>
      <a
        href="https://www.youtube.com/playlist?list=PLGSenmvp_iAE"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-10 items-center gap-1.5 rounded-md border bg-background px-4 text-sm font-medium text-foreground transition-colors hover:bg-accent"
      >
        Full playlist on YouTube
        <ArrowUpRight className="h-4 w-4" />
      </a>
    </div>
    <div class="mt-8">
      <ConsoleVideos client:visible />
    </div>
  </section>

  <MoreFromAkash />
</Layout>
