---
import { POSTS_GRID_CLASS } from "@/components/blog/blogUi";
import CategoryNav from "@/components/blog/category-nav.astro";
import PostCard from "@/components/cards/post-card.astro";
import TopMargin from "@/components/ui/top-margin.astro";
import Layout from "@/layouts/layout.astro";
import { getReadingTime } from "@/utils/readingTime";
import { getCollection } from "astro:content";

const title = "Community Contributions";
const description =
  "A global community collaborating and contributing to the development of the Akash Network.";

const allContributions = await getCollection("Community_Contributions_Page");
const contributions = allContributions.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

// Category links styled like the blog's; this page filters its own cards in
// the browser and keeps the choice in ?category=<name>.
const categories = ["News", "Guides", "Articles", "Student Ambassadors"];
const items = [
  { key: "all", label: "All", href: "/community/contributions/" },
  ...categories.map((category) => ({
    key: category.toLowerCase(),
    label: category,
    href: `/community/contributions/?category=${encodeURIComponent(category)}`,
  })),
];
---

<Layout
  title={title}
  description={description}
  image="/meta-images/community.png"
>
  <TopMargin isNotContainer>
    <div class="container">
      <div class="mb-10 space-y-5 md:mb-[60px] lg:mb-20">
        <h1
          class="text-4xl font-semibold leading-tight tracking-tight text-foreground md:text-5xl md:tracking-tighter lg:text-6xl"
        >
          {title}
        </h1>
        <p class="max-w-2xl text-base font-normal text-para">
          {description}
        </p>
      </div>

      <div data-contribution-categories>
        <CategoryNav
          items={items}
          active="all"
          label="Contribution categories"
        />
      </div>

      <div
        data-display="grid"
        class:list={["mt-10 md:mt-12", POSTS_GRID_CLASS]}
      >
        {
          contributions.map((contribution) => {
            const isExternal = Boolean(
              contribution.data.external && contribution.data.link,
            );

            return (
              <PostCard
                href={
                  isExternal
                    ? contribution.data.link
                    : `/community/contributions/${contribution.id}`
                }
                external={isExternal}
                title={contribution.data.title}
                image={contribution.data.bannerImage}
                tag={contribution.data.categories[0]}
                contributor={contribution.data.contributors[0]}
                pubDate={contribution.data.pubDate}
                readingTime={getReadingTime(contribution.body)}
                data-category={
                  contribution.data.categories[0]?.toLowerCase() ?? ""
                }
              />
            );
          })
        }
      </div>
    </div>
  </TopMargin>
</Layout>

<script>
  function initFilters() {
    const nav = document.querySelector("[data-contribution-categories]");
    if (!nav) return;
    const links = [
      ...nav.querySelectorAll<HTMLAnchorElement>("[data-category-key]"),
    ];
    const scroller = nav.querySelector<HTMLElement>("[data-category-scroller]");
    const cards = document.querySelectorAll<HTMLElement>("[data-category]");

    const show = (key: string) => {
      links.forEach((link) => {
        if (link.dataset.categoryKey !== key) {
          link.removeAttribute("aria-current");
          return;
        }
        link.setAttribute("aria-current", "page");
        // Centre the pill in a row that scrolls (phones); scrollIntoView
        // would also scroll the page.
        if (scroller && scroller.scrollWidth > scroller.clientWidth) {
          scroller.scrollLeft =
            link.offsetLeft - (scroller.clientWidth - link.offsetWidth) / 2;
        }
      });
      cards.forEach((card) => {
        card.style.display =
          key === "all" || card.dataset.category === key ? "" : "none";
      });
    };

    links.forEach((link) =>
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
          return;
        }
        event.preventDefault();
        show(link.dataset.categoryKey ?? "all");
        window.history.replaceState(window.history.state, "", link.href);
      }),
    );

    const param = new URLSearchParams(window.location.search)
      .get("category")
      ?.toLowerCase();
    if (param && links.some((link) => link.dataset.categoryKey === param)) {
      show(param);
    }
  }

  document.addEventListener("astro:page-load", initFilters);
</script>
