---
import Layout from "@/layouts/layout.astro";
import TopMargin from "@/components/ui/top-margin.astro";

const tiles = [
  {
    title: "AI Inference & Training",
    description:
      "Run AI inference and training on GPUs rented from independent providers. OpenAI-compatible endpoints through AkashML, or bring your own container.",
    href: "/use-cases/ai-product-engineering/",
    image: "/use-cases/use-cases-ai-engineering.webp",
  },
  {
    title: "Enterprise",
    description:
      "Reserved NVIDIA B300, B200, H200, H100, and A100 GPU capacity with confidential computing, InfiniBand networking, bare metal access, and dedicated enterprise support.",
    href: "/use-cases/enterprise/",
    image: "/use-cases/use-cases-enterprise.webp",
  },
  {
    title: "Academic & Institutional Research",
    description:
      "Open research needs open compute. Akash provides academic institutions with cost-effective, permissionless access to high-performance compute for AI and scientific workloads.",
    href: "/use-cases/universities/",
    image: "/development/universities-hero.webp",
  },
  {
    title: "Compute Providers",
    description:
      "Connect your servers to Akash and let tenants bid on unused CPU, GPU, memory, and storage. You set the minimum price.",
    href: "/use-cases/providers/",
    image: "/use-cases/use-cases-providers.webp",
  },
  {
    title: "Startups",
    description:
      "Skip the sales calls and waitlists. Akash gives early-stage teams direct access to GPU capacity priced by open bidding — no markups, no lock-in.",
    href: "/use-cases/startups/",
    image: "/development/startups-hero.webp",
  },
];
---

<Layout
  title="Use Cases — Akash Network"
  description="Startups, enterprises, research institutions, and data center operators use Akash to run containerized AI workloads or sell unused compute capacity."
  image="/use-cases/use-cases-enterprise.webp"
>
  <TopMargin readable>
    <div class="flex flex-col gap-16 pt-4 pb-28 md:gap-24">
      <div class="space-y-4">
        <h1 class="text-4xl font-semibold leading-tight tracking-tight text-foreground md:text-5xl lg:text-6xl">
          Use Cases
        </h1>
        <p class="max-w-2xl text-base font-normal leading-relaxed text-para">
          From high-growth AI startups to global data centers, teams use Akash to deploy scalable container workloads and monetize enterprise compute.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        {tiles.map((tile) => (
          <a
            href={tile.href}
            class="group flex flex-col overflow-hidden rounded-xl border border-input bg-background transition-colors hover:bg-accent"
          >
            <div class="overflow-hidden">
              <img
                src={tile.image}
                alt={tile.title}
                class="h-[220px] w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-[1.03] group-hover:brightness-105"
              />
            </div>
            <div class="flex flex-1 flex-col gap-3 p-6">
              <h2 class="text-xl font-semibold text-foreground">{tile.title}</h2>
              <p class="text-sm font-normal leading-relaxed text-para">
                {tile.description}
              </p>
              <div class="mt-auto flex items-center gap-1 pt-4 text-sm font-medium text-foreground">
                Learn more
                <svg
                  class="h-4 w-4 translate-x-0 transition-transform duration-200 group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </TopMargin>
</Layout>
