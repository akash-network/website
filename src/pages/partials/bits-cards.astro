---
import PostCard from "@/components/cards/post-card.astro";
import { getBitsPosts, getPostTagSlugs } from "@/utils/bitsTaxonomy";

// Every Bid listing card as an HTML fragment (no layout), for the blog
// controls on The Bid; see partials/blog-cards.astro. Tags serve as both the
// categories and the filter topics. Excluded from the sitemap in
// astro.config.mjs.
export const partial = true;

const posts = await getBitsPosts();
---

{
  posts.map((post) => (
    <PostCard
      href={`/the-bid/${post.id}`}
      title={post.data.title}
      image={post.data.bannerImage}
      tag={post.data.tags[0]}
      contributor={post.data.author}
      pubDate={post.data.pubDate}
      hideTag
      hideDate
      hideAuthor
      data-date={post.data.pubDate.toISOString()}
      data-year={post.data.pubDate.getUTCFullYear()}
      data-categories={getPostTagSlugs(post).join(",")}
      data-topics={getPostTagSlugs(post).join(",")}
    />
  ))
}
