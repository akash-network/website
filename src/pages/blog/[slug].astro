---
import AkashMLBanner from "@/components/akashml-banner.astro";
import CalloutsClasses from "@/components/callouts-classes.astro";
import FormattedDate from "@/components/formatted-date.astro";
import BlogLayout from "@/layouts/blog-layout.astro";
import { blogPostProseClasses } from "@/lib/prose-classes";
import { isCaseStudy, toCategorySlug } from "@/utils/blogTaxonomy";
import { getReadingTime } from "@/utils/readingTime";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("Blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const { Content } = await render(post);
const readingTime = getReadingTime(post.body);

const category = post.data.categories[0];
const categoryLabel = category.charAt(0).toUpperCase() + category.slice(1);
const categoryHref = isCaseStudy(post)
  ? "/case-studies"
  : `/blog/${toCategorySlug(category)}/1`;
---

<BlogLayout
  image={post.data.bannerImage.src}
  title={post.data.metaTitle ? post.data.metaTitle : post.data.title}
  description={post.data.metaDescription
    ? post.data.metaDescription
    : post.data.description}
>
  <div class="grid grid-cols-12 md:gap-x-10 lg:gap-x-16">
    <header class="col-span-12 md:col-span-8">
      <!-- shadcn/ui Breadcrumb with a slash separator -->
      <nav aria-label="Breadcrumb">
        <ol
          class="flex flex-wrap items-center gap-2 text-sm text-neutral-600 dark:text-neutral-400"
        >
          <li>
            <a href="/blog" class="transition-colors hover:text-foreground">
              Blog
            </a>
          </li>
          <li role="presentation" aria-hidden="true">/</li>
          <li>
            <a
              href={categoryHref}
              class="transition-colors hover:text-foreground"
            >
              {categoryLabel}
            </a>
          </li>
        </ol>
      </nav>

      <h1
        class="mt-3 text-[40px] !font-[450] leading-[48px] tracking-[-0.06em] md:text-5xl md:leading-[56px]"
      >
        {post.data.title}
      </h1>

      <p class="mt-5 text-sm text-foreground">
        By {post.data.contributors.join(", ")}
      </p>

      <!-- From md up, the date and reading time sit in the sidebar. -->
      <p
        class="mt-2 flex items-center gap-2 text-sm text-muted-foreground md:hidden"
      >
        <FormattedDate date={post.data.pubDate} />
        {
          readingTime && (
            <>
              <span
                aria-hidden="true"
                class="size-1 rounded-full bg-current opacity-50"
              />
              {readingTime} min read
            </>
          )
        }
      </p>
    </header>
  </div>

  <div class="mt-8 grid grid-cols-12 md:gap-x-10">
    <article class="col-span-12 md:col-span-8">
      <div>
        <Image
          src={post.data.bannerImage}
          alt={`banner image for the post ${post.data.title}`}
          width={1200}
          format="webp"
          class="inset-0 aspect-video bg-gray-200 object-cover"
          loading="lazy"
          quality="max"
        />
      </div>

      <article class={blogPostProseClasses}>
        <Content />
      </article>
    </article>

    <aside class="col-span-4 hidden space-y-8 md:block">
      <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
        <dt class="text-muted-foreground">Published</dt>
        <dd class="text-foreground">
          <FormattedDate date={post.data.pubDate} />
        </dd>
        {
          readingTime && (
            <>
              <dt class="text-muted-foreground">Reading time</dt>
              <dd class="text-foreground">{readingTime} min read</dd>
            </>
          )
        }
      </dl>

      <AkashMLBanner />
    </aside>
  </div>

  <AkashMLBanner class="mb-10 mt-10 md:hidden" />

  <CalloutsClasses />
</BlogLayout>
