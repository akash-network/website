---
import BlogFilterBar from "@/components/blog/blog-filter-bar.astro";
import BlogPosts from "@/components/blog/blog-posts.astro";
import { POSTS_PER_PAGE } from "@/components/blog/blogUi";
import PostCard from "@/components/cards/post-card.astro";
import Layout from "@/layouts/layout.astro";
import { byNewest, isCaseStudy } from "@/utils/blogTaxonomy";
import { getReadingTime } from "@/utils/readingTime";
import type { PaginateFunction } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";

type BlogPost = CollectionEntry<"Blog">;

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction;
}) {
  const posts = (await getCollection("Blog"))
    .filter((post) => post.data.archive !== true && !isCaseStudy(post))
    .sort(byNewest);

  return paginate(posts, {
    // The newest post's banner stays the listing's social image.
    props: { ogImage: posts[0].data.bannerImage.src },
    pageSize: POSTS_PER_PAGE,
  });
}

const { page, ogImage } = Astro.props;
---

<Layout
  title="Akash Network Blog - Insights into Decentralized Cloud Computing"
  description="Stay updated with the latest trends, news, and insights in decentralized cloud computing. Explore thought leadership, technical deep-dives, and community highlights."
  image={ogImage}
>
  <div class="container mt-10 md:mt-16">
    <BlogFilterBar />

    <BlogPosts page={page}>
      {
        page.data.map((post: BlogPost) => (
          <PostCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            image={post.data.bannerImage}
            tag={post.data.categories[0]}
            contributor={post.data.contributors[0]}
            pubDate={post.data.pubDate}
            readingTime={getReadingTime(post.body)}
          />
        ))
      }
    </BlogPosts>
  </div>
</Layout>
