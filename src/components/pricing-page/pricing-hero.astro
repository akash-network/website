---
type Props = {
  /** Pass an array to force line breaks between the parts (from md up). */
  title: string | string[];
  /** Same as `title`: an array breaks the description into lines from md up. */
  description: string | string[];
  /** Vertical alignment of the two columns from xl up. "end" suits a short aside; a tall one
   *  reads better with "start", so the headline isn't pushed down to its bottom edge. */
  align?: "end" | "start";
};

const { title, description, align = "end" } = Astro.props;
const titleLines = Array.isArray(title) ? title : [title];
const descriptionLines = Array.isArray(description)
  ? description
  : [description];

// With an "aside" (e.g. a CTA), the description sits under the headline and the aside takes the
// right column; otherwise the description takes the right column. Default-slot content goes
// under the headline.
const hasAside = Astro.slots.has("aside");
---

<div
  class:list={[
    "grid gap-8 xl:grid-cols-[minmax(0,1fr)_minmax(0,420px)] xl:gap-16",
    align === "start" ? "xl:items-start" : "xl:items-end",
  ]}
>
  <div>
    <h1
      class="text-4xl font-medium leading-[1.05] tracking-tight md:tracking-tighter text-foreground md:text-5xl lg:text-6xl"
    >
      {
        titleLines.map((line, index) => (
          <span class="md:block">
            {line}
            {index < titleLines.length - 1 && " "}
          </span>
        ))
      }
    </h1>
    {
      hasAside && (
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground md:text-lg">
          {descriptionLines.map((line, index) => (
            <span class="md:block">
              {line}
              {index < descriptionLines.length - 1 && " "}
            </span>
          ))}
        </p>
      )
    }
    <slot />
  </div>
  {
    hasAside ? (
      <slot name="aside" />
    ) : (
      <p class="max-w-xl text-base leading-relaxed text-muted-foreground md:text-lg">
        {descriptionLines.map((line, index) => (
          <span class="md:block">
            {line}
            {index < descriptionLines.length - 1 && " "}
          </span>
        ))}
      </p>
    )
  }
</div>
