---
import Layout from "@/layouts/layout.astro";

type Props = {
  title: string;
  description: string;
  image?: string;
  noIndex?: boolean;
};

const { title, description, image, noIndex } = Astro.props;
---

<Layout
  title={`${title} | Explore Pricing and Earnings on Akash`}
  description={description}
  image={image || "/meta-images/gpus.png"}
  noIndex={noIndex}
>
  <section
    class="container flex flex-col gap-10 pb-20 pt-10 md:gap-12 md:pb-28 md:pt-16"
  >
    <slot />
  </section>
</Layout>
