---
const { howItWorksSection } = Astro.props;
---

<div id="how-it-works" class="space-y-10">
  <div class="space-y-4">
    <h2 class="font-sans text-3xl !font-medium leading-snug tracking-tight text-foreground md:text-4xl">
      {howItWorksSection.title}
    </h2>
  </div>

  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      howItWorksSection.cards.map((card: { title: string; description: string }) => (
        <div class="space-y-3">
          <h3 class="text-base font-semibold text-foreground">{card.title}</h3>
          <p class="text-sm font-normal leading-relaxed text-para">{card.description}</p>
        </div>
      ))
    }
  </div>
</div>
