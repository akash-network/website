---
import { cn } from "@/lib/utils";
import { ChevronLeft, ChevronRight } from "lucide-react";

// Category links of the blog-style listings (the navigation pattern of
// shadcn's own site: muted text, the current one on a muted pill; edges fade
// while the row scrolls). The current link is styled from aria-current, so
// listings that switch categories in the browser only move that attribute.

interface Props {
  items: { key: string; label: string; href: string }[];
  active: string;
  /** Accessible name of the nav, e.g. "Blog categories". */
  label: string;
  class?: string;
}

const { items, active, label, class: className } = Astro.props;
---

<nav
  aria-label={label}
  class={cn("group/categories relative min-w-0", className)}
>
  <!-- No scrollbar: the faded edges show there is more, touch swipes, and
       mouse users get the arrow buttons below. -m-1 p-1 keeps focus rings
       from being clipped by the scroll container. -->
  <div
    data-category-scroller
    class="relative -m-1 flex items-center gap-1 overflow-x-auto p-1 [scrollbar-width:none] data-[fade=start]:[mask-image:linear-gradient(to_left,#000_calc(100%-3rem),transparent)] data-[fade=end]:[mask-image:linear-gradient(to_right,#000_calc(100%-3rem),transparent)] data-[fade=both]:[mask-image:linear-gradient(to_right,transparent,#000_3rem,#000_calc(100%-3rem),transparent)] [&::-webkit-scrollbar]:hidden"
  >
    {
      items.map((item) => (
        <a
          href={item.href}
          data-category-key={item.key}
          aria-current={item.key === active ? "page" : undefined}
          class="inline-flex h-8 shrink-0 items-center justify-center whitespace-nowrap rounded-full px-3 text-sm text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:ring-[3px] focus-visible:ring-neutral-400/50 aria-[current=page]:bg-neutral-100 aria-[current=page]:text-foreground dark:focus-visible:ring-neutral-500/50 dark:aria-[current=page]:bg-neutral-800"
        >
          {item.label}
        </a>
      ))
    }
  </div>

  <!-- Scroll buttons for mouse and trackpad users: they fade in over the
       gradient edge only while the row is hovered, and only towards an
       edge that has more categories. Touch devices swipe instead, and
       keyboard focus scrolls each link into view, so they are skipped
       in the tab order. -->
  {
    [
      { direction: -1, label: "Scroll categories left", Icon: ChevronLeft },
      {
        direction: 1,
        label: "Scroll categories right",
        Icon: ChevronRight,
      },
    ].map(({ direction, label, Icon }) => (
      <button
        type="button"
        data-category-scroll={direction}
        aria-label={label}
        tabindex="-1"
        class={cn(
          "pointer-events-none absolute top-1/2 hidden size-8 -translate-y-1/2 items-center justify-center rounded-full bg-background text-foreground opacity-0 ring-1 ring-foreground/10 transition-[opacity,background-color] duration-200 hover:bg-neutral-100 group-hover/categories:pointer-events-auto group-hover/categories:opacity-100 dark:hover:bg-neutral-800 [@media(pointer:fine)]:data-[visible]:inline-flex",
          direction < 0 ? "left-0" : "right-0",
        )}
      >
        <Icon className="size-4" aria-hidden="true" />
      </button>
    ))
  }
</nav>

<!-- Keep the current category in view, fade the edges that have more
     categories past them and show the matching scroll buttons.
     data-astro-rerun: ClientRouter skips inline scripts it has already run. -->
<script is:inline data-astro-rerun>
  document.querySelectorAll("[data-category-scroller]").forEach((scroller) => {
    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      const start = scroller.scrollLeft > 1;
      const end = scroller.scrollLeft < max - 1;
      scroller.dataset.fade =
        start && end ? "both" : start ? "start" : end ? "end" : "";
      sync(start, end);
    };
    const nav = scroller.closest("nav");
    const buttons = [...nav.querySelectorAll("[data-category-scroll]")];
    const sync = (start, end) =>
      buttons.forEach((button) =>
        button.toggleAttribute(
          "data-visible",
          button.dataset.categoryScroll === "-1" ? start : end,
        ),
      );
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    buttons.forEach((button) =>
      button.addEventListener("click", () =>
        scroller.scrollBy({
          left:
            Number(button.dataset.categoryScroll) * scroller.clientWidth * 0.7,
          behavior: reduceMotion.matches ? "auto" : "smooth",
        }),
      ),
    );
    const current = scroller.querySelector('[aria-current="page"]');
    if (current && scroller.scrollWidth > scroller.clientWidth) {
      scroller.scrollLeft =
        current.offsetLeft - (scroller.clientWidth - current.offsetWidth) / 2;
    }
    update();
    scroller.addEventListener("scroll", update, { passive: true });
    new ResizeObserver(update).observe(scroller);
  });
</script>
