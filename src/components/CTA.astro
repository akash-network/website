---
import { shouldHideCta } from "@/utils/hideCta";
import clsx from "clsx";

const pathname = Astro.url.pathname;
const disableMargin = ["/deploy", "/providers"];

const shouldHide = shouldHideCta(pathname);
---

<section
  class={clsx(
    shouldHide && "hidden",
    (pathname === "/" || pathname.startsWith("/meetingconfirmation")) && "hidden",
    "flex flex-col items-center justify-center",
    "bg-gray-50 dark:bg-background2",
    "border-y",
    "px-[30px] py-[80px] lg:py-[160px]",
    disableMargin.includes(pathname) ? "mt-0" : "mt-20",
    "text-center",
  )}
>
  <h2
    class={clsx(
      "max-w-[900px] font-sans font-semibold tracking-tight text-foreground",
      "text-3xl md:text-5xl xl:text-6xl",
      "md:leading-snug",
    )}
  >
    Start Building
  </h2>

  <p class="mt-4 md:mt-6 max-w-[600px] text-sm md:text-base leading-relaxed text-para">
    Launch containerized AI workloads via our self-serve console, or coordinate custom enterprise infrastructure configs with our team.
  </p>

  <div class="mt-8 md:mt-10 flex flex-wrap items-center justify-center gap-3">
    <a
      href="https://console.akash.network/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center rounded-md bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-80"
    >
      Deploy Now
    </a>
    <a
      href="/gpus-on-demand"
      class="inline-flex items-center rounded-md border border-border bg-background px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-accent"
    >
      Get in Touch
    </a>
  </div>
</section>
