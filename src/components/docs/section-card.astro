---
const { icon, title, description, link } = Astro.props;
---

<a
  href={link}
  class="not-prose group flex flex-col rounded-xl border border-[#e6e8eb] bg-background p-6 transition-colors hover:border-neutral-300 hover:bg-neutral-50 dark:border-[#333] dark:hover:border-neutral-700 dark:hover:bg-neutral-900"
>
  <div
    set:html={icon}
    class="h-5 w-5 text-foreground [&>svg]:h-5 [&>svg]:w-5 [&>svg]:stroke-[1.5]"
  />
  <h4 class="mt-4 text-base font-semibold tracking-[-0.02em] text-foreground">
    {title}
  </h4>
  <p class="mt-1 text-sm leading-5 text-muted-foreground">{description}</p>
</a>
