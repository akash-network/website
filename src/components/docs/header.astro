---
import Logo from "../ui/logo.astro";
---

<nav class="flex h-16 border-b border-[#e6e8eb] dark:border-[#333]">
  <div class="flex w-full items-center justify-between gap-3 px-5">
    <!-- Left side: Logo / Docs -->
    <div class="flex items-center gap-2">
      <!-- Same logo size as the marketing header -->
      <a href="/" class="flex items-center" aria-label="Akash Network home">
        <Logo width={95} />
      </a>
      <span
        aria-hidden="true"
        class="relative top-0.5 select-none text-lg leading-none text-black dark:text-white"
        >•</span
      >
      <!-- Same ink as the logo (black / white), a touch smaller than the wordmark -->
      <a
        href="/docs/"
        class="relative top-px text-[23px] font-normal leading-none tracking-[-0.04em] text-black transition-opacity hover:opacity-70 dark:text-white"
      >
        Documentation
      </a>
    </div>

    <!-- Right side: same CTA pair as the marketing header -->
    <div class="flex items-center gap-2">
      <a
        href="/gpus-on-demand"
        class="inline-flex items-center justify-center rounded-md bg-zinc-100 px-[11px] py-[7px] text-xs font-medium text-foreground transition-colors hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700"
      >
        Get in Touch
      </a>
      <a
        id="console-header"
        href="https://console.akash.network/"
        class="inline-flex items-center justify-center rounded-md bg-black px-[11px] py-[7px] text-xs font-medium text-white transition-colors hover:bg-black/90 dark:bg-white dark:text-black dark:hover:bg-white/90"
      >
        Deploy Now
      </a>
    </div>
  </div>
</nav>
