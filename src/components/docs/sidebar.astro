---
import { ChevronRightIcon } from "lucide-react";
import AlgoliaSearch from "./algolia-search.jsx";
import { DocsNav, HomeButton } from "./docs-nav";

const { nav } = Astro.props;

const pathname = new URL(Astro.request.url).pathname;

const supportIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/></svg>`;
---

<aside
  id="docs-sidebar"
  class="sidebar-scroll sticky top-0 h-[100dvh] w-[260px] flex-shrink-0 self-start overflow-y-auto px-3 pb-6 lg:top-16 lg:h-[calc(100vh-64px)] xl:w-[288px]"
>
  <!-- Search stays pinned above the nav while it scrolls -->
  <div class="sticky top-0 z-10 bg-background pb-3 pt-4">
    <div class="h-9">
      <AlgoliaSearch client:only />
    </div>
  </div>

  <div class="flex flex-col gap-0.5">
    <HomeButton pathname={pathname} client:load />
  </div>

  <div class="mt-4">
    <DocsNav client:only docsNav={nav} pathName={[]}>
      <div class="hidden flex-col md:flex" slot="fallback">
        {
          nav?.[0]?.subItems?.map((navItem: any) => (
            <div class="flex min-h-8 w-full items-center justify-between gap-x-2 rounded-md px-2 py-1.5 text-sm text-neutral-600 dark:text-neutral-400">
              <span class="flex-1 text-left">{navItem.label}</span>
              <ChevronRightIcon className="h-4 w-4" />
            </div>
          ))
        }
      </div>
    </DocsNav>
  </div>

  <!-- Support Link -->
  <div class="mt-4 border-t border-[#e6e8eb] pt-4 dark:border-[#333]">
    <a
      href="/support/"
      class={`flex min-h-8 items-center gap-x-2 rounded-md px-2 py-1.5 text-sm transition-colors ${
        pathname === "/support/"
          ? "bg-neutral-100 font-medium text-foreground dark:bg-neutral-800/80"
          : "text-neutral-600 hover:bg-neutral-100/70 hover:text-foreground dark:text-neutral-400 dark:hover:bg-neutral-800/50"
      }`}
    >
      <span set:html={supportIcon} />
      Support
    </a>
  </div>
</aside>
