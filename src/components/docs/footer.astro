---
// Import required assets
import DarkModeToggle from "../dark-mode-toggle";
import {
  DiscordIcon,
  GithubIcon,
  TwitterIcon,
  YoutubeIcon,
} from "../header/icons";
import Logo from "../ui/logo.astro";

const socials = [
  { name: "X", link: "https://x.com/akashnet", icon: TwitterIcon },
  {
    name: "GitHub",
    link: "https://github.com/akash-network",
    icon: GithubIcon,
  },
  {
    name: "Discord",
    link: "https://discord.com/invite/akash",
    icon: DiscordIcon,
  },
  {
    name: "YouTube",
    link: "https://www.youtube.com/@AkashNetwork",
    icon: YoutubeIcon,
  },
];
---

<footer
  class="mt-16 border-t border-[#e6e8eb] px-6 py-8 dark:border-[#333] md:px-8"
>
  <div
    class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between"
  >
    <!-- Logo: same mark and size as the marketing footer -->
    <a href="/" class="flex items-center" aria-label="Akash Network home">
      <Logo width={95} />
    </a>

    <!-- Social icons + theme toggle (mirrors the marketing footer) -->
    <div class="flex items-center gap-4">
      {
        socials.map((social) => (
          <a
            aria-label={`Akash Network ${social.name}`}
            href={social.link}
            target="_blank"
            class="text-muted-foreground transition-colors hover:text-foreground"
          >
            <social.icon />
          </a>
        ))
      }
      <div class="h-5 w-px bg-zinc-200 dark:bg-zinc-700"></div>
      <DarkModeToggle footer client:load />
    </div>
  </div>

  <!-- Copyright and Links -->
  <div
    class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted-foreground"
  >
    <span
      >© Akash Network {new Date().getFullYear()} The Akash Network Authors</span
    >
    <span class="h-3 w-px bg-[#e6e8eb] dark:bg-[#333]"></span>
    <span>Documentation distributed under CC BY 4.0</span>
    <span class="h-3 w-px bg-[#e6e8eb] dark:bg-[#333]"></span>
    <span>Open-source Apache 2.0 Licensed</span>
    <span class="h-3 w-px bg-[#e6e8eb] dark:bg-[#333]"></span>
    <span>GitHub v0.38.2</span>
    <span class="h-3 w-px bg-[#e6e8eb] dark:bg-[#333]"></span>
    <a href="/privacy/" class="transition-colors hover:text-foreground"
      >Privacy</a
    >
  </div>
</footer>
