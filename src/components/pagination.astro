---
import { OUTLINE_BUTTON_CLASS } from "@/components/blog/blogUi";
import { ChevronLeft, ChevronRight } from "lucide-react";

// shadcn/ui data-table pagination: page count plus outline Previous/Next
// buttons (links styled with the outline Button variant).
const { page } = Astro.props;
---

<nav
  aria-label="Pagination"
  class="mb-10 mt-[56px] flex items-center justify-between gap-4"
>
  <p class="text-sm font-medium text-muted-foreground">
    Page {page.currentPage} of {page.lastPage}
  </p>
  <div class="flex items-center gap-2">
    {
      page.url.prev && (
        <a href={page.url.prev} rel="prev" class={OUTLINE_BUTTON_CLASS}>
          <ChevronLeft className="size-4" aria-hidden="true" />
          Previous
        </a>
      )
    }
    {
      page.url.next && (
        <a href={page.url.next} rel="next" class={OUTLINE_BUTTON_CLASS}>
          Next
          <ChevronRight className="size-4" aria-hidden="true" />
        </a>
      )
    }
  </div>
</nav>
