---
import FormattedDate from "@/components/formatted-date.astro";
import { cn } from "@/lib/utils";
import { Image } from "astro:assets";

// shadcn/ui Card (image card): media flush to the top, then a headline with
// "date · category" above it and "author · reading time" below, on a px-6
// grid. The edge is a 1px ring at 10% foreground with no border or shadow, as
// in shadcn's current card styles; without a border the banner sits flush
// against the ring. The image placeholder uses shadcn's neutral muted colour
// as a literal because this site does not define --muted.
// Inside a post grid set to list view (data-display="list" on group/posts)
// the media is hidden.

interface Props {
  image: any;
  title: string;
  contributor: string;
  tag: string;
  pubDate: Date;
  href?: string;
  /** Minutes, from getReadingTime(post.body); omitted when unknown. */
  readingTime?: number;
  hideTag?: boolean;
  hideDate?: boolean;
  hideAuthor?: boolean;
  /** data-* attributes for client-side filtering (blog-cards partial). */
  [attribute: `data-${string}`]: string | number | undefined;
}

const {
  image,
  contributor,
  title,
  tag,
  pubDate,
  href,
  readingTime,
  hideTag = false,
  hideDate = false,
  hideAuthor = false,
  ...attributes
} = Astro.props;

const Root = href ? "a" : "article";
---

<Root
  href={href}
  class={cn(
    "group isolate flex h-full w-full flex-col overflow-hidden rounded-[14px] bg-background2 text-card-foreground ring-1 ring-foreground/10 transition-shadow hover:ring-foreground/20",
    href &&
      "outline-none focus-visible:ring-[3px] focus-visible:ring-neutral-400/50 dark:focus-visible:ring-neutral-500/50",
  )}
  {...attributes}
>
  <div
    class="aspect-video shrink-0 overflow-hidden bg-neutral-100 group-data-[display=list]/posts:hidden dark:bg-neutral-800"
  >
    <Image
      src={image}
      alt={`banner image for the post ${title}`}
      width={1200}
      format="webp"
      class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.02]"
      loading="lazy"
    />
  </div>

  <div
    class="flex flex-1 flex-col gap-6 py-6 group-data-[display=list]/posts:gap-4 group-data-[display=list]/posts:py-5"
  >
    <div class="flex flex-col gap-2 px-6">
      {
        (!hideTag || !hideDate) && (
          <div class="flex min-w-0 items-center gap-2 text-sm text-muted-foreground">
            {!hideDate && (
              <span class="shrink-0">
                <FormattedDate date={pubDate} />
              </span>
            )}
            {!hideDate && !hideTag && tag && (
              <span
                aria-hidden="true"
                class="size-1 shrink-0 rounded-full bg-current opacity-50"
              />
            )}
            {!hideTag && tag && <span class="truncate">{tag}</span>}
          </div>
        )
      }

      <h3
        class="line-clamp-2 text-pretty text-lg font-semibold leading-snug text-foreground"
      >
        {title}
      </h3>
    </div>

    {
      (!hideAuthor || (!hideDate && readingTime)) && (
        <div class="mt-auto flex min-w-0 items-center gap-2 px-6 text-sm text-muted-foreground">
          {!hideAuthor && <span class="truncate">By {contributor}</span>}
          {!hideAuthor && !hideDate && readingTime && (
            <span
              aria-hidden="true"
              class="size-1 shrink-0 rounded-full bg-current opacity-50"
            />
          )}
          {!hideDate && readingTime && (
            <span class="shrink-0">{readingTime} min read</span>
          )}
        </div>
      )
    }
  </div>
</Root>
